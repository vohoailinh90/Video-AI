# Dependencies
node_modules/

# Rendered output and captured frames: large and reproducible (`npx hyperframes render`)
renders/
snapshots/

# Output of the voiceover and preview tools (scripts/vo, scripts/preview)
build/

# HyperFrames runtime state: an edit-history cache that records machine-specific paths,
# check reports, lock dirs, and Lambda stack metadata (it identifies an AWS account)
.hyperframes/

# Secrets: provider keys (HeyGen, Gemini, ElevenLabs, Figma, ...) belong in the environment, never in the repo
.env
.env.*
!.env.example
service-account*.json
*credentials*.json

# Claude Code personal settings (the shared .claude/settings.json and .claude/skills/ stay tracked)
.claude/settings.local.json

# Python helpers (TTS, scripts)
.venv/
venv/
__pycache__/

# Logs, editors, OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db
