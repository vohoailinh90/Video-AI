# workers.env -- API keys for the WORKER models, one file per team (/srv/team, and
# /srv/team-codex if you set up the Codex team). Owner team, mode 600.
#
# Each worker container receives ONLY the key of its own model's provider. Code a
# model writes runs in that same container, so treat every key here as exposed to
# it: create dedicated keys with the smallest limit the provider allows (an
# OpenRouter key with a credit limit; a separate Google AI Studio project). Never
# put your Claude or Codex login or API key here: the lead (Claude Code, or Codex in
# the second team) runs only in your own CLI.
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
