# Worker image for the video team (docs/vps-team-video.md): the code team's OpenCode worker plus
# what a HyperFrames video with sound needs -- ffmpeg, Chrome, the Kokoro voice and GSAP -- all baked
# in, because the gates run with no network and a worker's HOME is an empty tmpfs.
#
#   docker build -t team-video-worker:latest -f /opt/team/Dockerfile.video /opt/team
#
# Pin the versions once a render works for you: a renderer that changes under an unattended pipeline
# draws different pixels from one run to the next.
FROM node:22-bookworm-slim

ARG OPENCODE_VERSION=latest
ARG HYPERFRAMES_VERSION=0.8.166
ARG GSAP_VERSION=3.14.2

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git ripgrep curl unzip \
      ffmpeg espeak-ng \
      python3 python3-pip python3-venv \
      fonts-liberation fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji \
      libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 \
      libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 libpango-1.0-0 libcairo2 libxshmfence1 \
 && rm -rf /var/lib/apt/lists/*

# The real CLI lives under /opt/hf; /usr/local/bin/hyperframes is the shim that links the baked cache.
RUN npm install -g "opencode-ai@${OPENCODE_VERSION}" \
 && npm install -g --prefix /opt/hf "hyperframes@${HYPERFRAMES_VERSION}" "gsap@${GSAP_VERSION}" \
 && npm cache clean --force \
 && mkdir -p /usr/local/share/team-video \
 && cp /opt/hf/lib/node_modules/gsap/dist/gsap.min.js /usr/local/share/team-video/gsap.min.js

# Local narration: Kokoro runs on the CPU, offline, once its model is cached below.
RUN python3 -m venv /opt/kokoro && /opt/kokoro/bin/pip install --no-cache-dir kokoro-onnx soundfile

ENV HYPERFRAMES_PYTHON=/opt/kokoro/bin/python \
    HYPERFRAMES_SKIP_SKILLS=1 HYPERFRAMES_NO_TELEMETRY=1 DO_NOT_TRACK=1 CI=1 \
    npm_config_offline=true

# Download Chrome and the Kokoro model into /opt/hfhome. The synthesis itself may still fail on a
# given espeak build: that only costs the local voice, and `doctor --smoke` reports it.
RUN HOME=/opt/hfhome /opt/hf/bin/hyperframes browser ensure \
 && (HOME=/opt/hfhome /opt/hf/bin/hyperframes tts "warm up" --output /tmp/warm.wav || echo "kokoro warm-up failed") \
 && rm -f /tmp/warm.wav \
 && chmod -R a+rX /opt/hfhome /opt/hf /opt/kokoro

COPY video/hyperframes-shim.sh /usr/local/bin/hyperframes
COPY video/video_gates.py /usr/local/lib/team-video/video_gates.py
COPY video/smoke /usr/local/share/team-video/smoke
RUN mkdir -p /usr/local/share/team-video/smoke/assets/vendor /usr/local/share/team-video/smoke/assets/audio \
 && cp /usr/local/share/team-video/gsap.min.js /usr/local/share/team-video/smoke/assets/vendor/ \
 && ffmpeg -v error -f lavfi -i "sine=frequency=330:duration=3,volume=1.5" -c:a libmp3lame \
      /usr/local/share/team-video/smoke/assets/audio/tone.mp3 \
 && chmod -R a+rX /usr/local/share/team-video /usr/local/lib/team-video

WORKDIR /work
