# team.env for the video team (/srv/team-video). Read as KEY=VALUE data, never executed.
# Everything not listed here keeps the defaults of team.env.example. Models are OpenCode ids,
# <provider>/<model>: `team-video models openrouter --free`, then `team-video doctor --ping`.
# Keep tester, coder and reviewer on DIFFERENT model families.
TEAM_MODELS_TESTER="mistral/<model id from: team-video models mistral> google/<flash-lite id>"
TEAM_MODELS_CODER="openrouter/<vendor/model:free from: team-video models openrouter --free> mistral/<model id>"
TEAM_MODELS_REVIEWER="google/<flash id from: team-video models google> openrouter/<another vendor/model:free>"

# The image with Chrome, ffmpeg, HyperFrames and the local voice (setup-vps-team.sh --with-video).
TEAM_IMAGE=team-video-worker:latest
TEAM_CODER_ATTEMPTS=3

# A render needs room: Chrome wants /dev/shm, the frame cache lives in /tmp (counted against memory).
# The VPS (4 vCPU / 8 GB) also runs CI, and one pipeline runs at a time.
TEAM_WORKER_MEMORY=4g
TEAM_WORKER_CPUS=3
TEAM_WORKER_SHM=1g
TEAM_WORKER_TMP=2g
TEAM_WORKER_TIMEOUT=2400
# Only team-net has the egress rules: the conductor refuses a container on any other network (TEAM_GATES_NETWORK: none or this one).
TEAM_WORKER_NETWORK=team-net

# Gates render a draft with no network. GSAP and every font and image must be files in the repo.
TEAM_GATES_SETUP=
TEAM_GATES_NETWORK=none
TEAM_GATE_TIMEOUT=1800

TEAM_PACK_MAX_LINES=1500
# Each video's diff carries the vendored gsap.min.js (about 70 KB): keep the ceiling above that.
TEAM_PACK_MAX_BYTES=250000
# A container's output goes into its log only up to this many bytes (a looping process cannot fill the disk); the end of it is kept for the pack.
TEAM_LOG_MAX_BYTES=20000000
TEAM_BASE=main
TEAM_GIT_NAME=team-bot
TEAM_GIT_EMAIL=team-bot@localhost
