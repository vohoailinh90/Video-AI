# team.env -- settings for team.py, one file per team (/srv/team, and /srv/team-codex for the
# Codex team). Read as KEY=VALUE data, never executed. Below, <team> is `team`, or `team-codex`
# for the Codex team.
#
# Models are OpenCode ids, <provider>/<model>. The first is the primary, the rest
# are fallbacks in order. Free lists rotate without notice: list what a provider
# offers right now with `<team> models <provider>` (`--free` for OpenRouter), then
# confirm with `<team> doctor --ping`.
#
# Keep tester, coder and reviewer on DIFFERENT model families, so the checker does
# not share the writer's blind spots (`<team> doctor` warns when they match).
# Private repository? Use only endpoints that do not train on your prompts
# (docs/vps-team.md, "Quyền riêng tư").
TEAM_MODELS_TESTER="mistral/<model id from: <team> models mistral> google/<flash-lite id>"
TEAM_MODELS_CODER="openrouter/<vendor/model:free from: <team> models openrouter --free> mistral/<model id>"
TEAM_MODELS_REVIEWER="google/<flash id from: <team> models google> openrouter/<another vendor/model:free>"
# NVIDIA NIM (build.nvidia.com, free trial tier, rate-limited) makes a good last
# fallback when a daily free quota runs out: append an id from
# `<team> models nvidia`, e.g. nvidia/deepseek-ai/deepseek-v4.1-flash to the coder
# and nvidia/z-ai/glm-5.3 to the reviewer.

# Coder attempts before the pipeline stops as blocked. Attempts rotate through
# TEAM_MODELS_CODER, and each retry gets the failing gate output as feedback.
TEAM_CODER_ATTEMPTS=3

# Container limits. The CX33 has 4 vCPU / 8 GB and also runs CI jobs.
TEAM_WORKER_TIMEOUT=1800
TEAM_WORKER_MEMORY=3g
TEAM_WORKER_CPUS=2
TEAM_IMAGE=team-worker:latest
# Workers reach the internet only (setup-vps-team.sh limits team-net with iptables). Only team-net has those rules:
# the conductor refuses to start a container on any other network (TEAM_GATES_NETWORK may be none or this one).
TEAM_WORKER_NETWORK=team-net

# Gates run acceptance.md on a clean checkout with no network. If your tests need
# dependencies installed first, set a setup command; it alone runs with network,
# into the same throwaway checkout. Example for Python:
#   TEAM_GATES_SETUP="python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt"
TEAM_GATES_SETUP=
TEAM_GATES_NETWORK=none
TEAM_GATE_TIMEOUT=900

# The audit pack the lead reads. Bigger means more of the lead's quota per audit.
TEAM_PACK_MAX_LINES=1500
# Lines can hide size (a minified file is one line), so the pack has a byte ceiling too.
TEAM_PACK_MAX_BYTES=250000
# A container's output goes into its log only up to this many bytes (a looping process cannot fill the disk); the end of it is kept for the pack.
TEAM_LOG_MAX_BYTES=20000000
# /work is the host checkout bind-mounted into the container, so the tmpfs and memory limits do not bound it: a container is stopped
# (and a worker's attempt discarded) once the directory has grown by more than this many bytes since it started.
TEAM_WORKSPACE_GROWTH_BYTES=3000000000

TEAM_BASE=main
TEAM_GIT_NAME=team-bot
TEAM_GIT_EMAIL=team-bot@localhost

# A provider team.py does not know: name the variable its OpenCode SDK reads.
# TEAM_KEY_ZAI=ZHIPU_API_KEY
